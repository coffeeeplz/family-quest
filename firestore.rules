rules_version = '2';

// 가족 퀘스트 보안 규칙
// - 가족 구성원만 그 가족의 데이터를 볼 수 있다.
// - 퀘스트 만들기, 승인, 코인 지급, 설정 변경은 부모만 할 수 있다.
// - 자녀는 자기 퀘스트의 완료 요청, 내 할 일 추가, 코인 제안, 보상 신청만 할 수 있고 코인 잔액은 바꿀 수 없다.
// - 보상을 사는 코인은 부모가 승인할 때만 빠지고, 잔액은 0 아래로 내려갈 수 없다.
// - 뭐먹지의 메뉴는 가족 누구나 올리고, 먹고 싶다는 표시와 먹은 날 기록도 누구나 할 수 있다. 별점은 자기 것만 준다.
//   내용을 고치거나 지우는 것은 올린 사람과 부모만 할 수 있다.
// - 캘린더의 일정은 가족 누구나 올리고, 고치기와 지우기는 올린 사람과 부모만 할 수 있다.
// - 위치 기록은 본인 것만 남길 수 있고 가족만 볼 수 있다. 장소 이름은 부모가 관리한다.
// - 위치 공유 코인은 예외적으로 본인이 직접 받지만, 가족 설정에 정해진 금액만, 하루에 정해진 횟수까지만 받을 수 있다.
// - 자녀가 퀘스트를 만들 수 있는 경우는 두 가지뿐이다:
//     부모가 낸 금액을 수락했을 때, 부모가 허용한 "자주 쓰는 퀘스트" 버튼을 눌렀을 때.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(fid, uid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(uid);
    }

    function isMember(fid) {
      return signedIn() && exists(memberPath(fid, request.auth.uid));
    }

    function isParent(fid) {
      return signedIn() && get(memberPath(fid, request.auth.uid)).data.role == 'parent';
    }

    function validCoins(amount) {
      return amount is int && amount > 0 && amount <= 1000;
    }

    // 초대코드가 이 가족, 이 역할용이고 기한이 남았는가
    function validInvite(fid, code, role) {
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return invite.familyId == fid
        && invite.role == role
        && invite.expiresAt > request.time.toMillis();
    }

    function validQuest(fid) {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.reward is int && d.reward >= 0 && d.reward <= 1000
        && d.active is bool
        && exists(memberPath(fid, d.assigneeUid));
    }

    // 자녀가 부모의 제안 금액을 수락해서 만드는 퀘스트(퀘스트 id = 제안 id)
    function questFromAgreement(fid, qid) {
      let d = request.resource.data;
      let before = get(/databases/$(database)/documents/families/$(fid)/proposals/$(qid)).data;
      let after = getAfter(/databases/$(database)/documents/families/$(fid)/proposals/$(qid)).data;
      return before.ownerUid == request.auth.uid
        && before.status == 'negotiating'
        && before.lastRole == 'parent'
        && after.status == 'agreed'
        && d.assigneeUid == request.auth.uid
        && d.reward == before.lastAmount
        && d.repeat.type == 'none'
        && d.active == true;
    }

    // 자녀가 허용된 "자주 쓰는 퀘스트" 버튼으로 만드는 퀘스트(버튼마다 하루 한 번)
    function questFromPreset(fid, qid) {
      let d = request.resource.data;
      let preset = get(/databases/$(database)/documents/families/$(fid)/presets/$(d.presetId)).data;
      return preset.childCanAdd == true
        && d.title == preset.title
        && d.reward == preset.reward
        && d.assigneeUid == request.auth.uid
        && d.repeat.type == 'none'
        && d.active == true
        && qid == d.presetId + '_' + request.auth.uid + '_' + d.repeat.date;
    }

    // 자녀의 완료 요청: 내 퀘스트이고, 보상이 퀘스트에 적힌 값(늦었으면 절반, 올림)과 같아야 한다.
    function validSubmission(fid, rid) {
      let d = request.resource.data;
      let quest = get(/databases/$(database)/documents/families/$(fid)/quests/$(d.questId)).data;
      return d.assigneeUid == request.auth.uid
        && d.status == 'submitted'
        && d.decidedBy == null
        && rid == d.questId + '_' + d.dateKey
        && quest.active == true
        && quest.assigneeUid == request.auth.uid
        && (
          (d.late == true && (d.reward * 2 == quest.reward || d.reward * 2 == quest.reward + 1))
          || (d.late != true && d.reward == quest.reward)
        );
    }

    // 퀘스트 코인 지급: 같은 묶음에서 승인된 수행 기록과 금액, 받는 사람이 일치해야 한다.
    function validQuestPayout(fid, lid) {
      let run = getAfter(/databases/$(database)/documents/families/$(fid)/runs/$(lid)).data;
      return run.status == 'approved'
        && run.reward == request.resource.data.amount
        && run.assigneeUid == request.resource.data.uid;
    }

    // 보상 신청: 내 이름으로, 상점에 올라 있는 보상을 적힌 가격 그대로 신청해야 한다.
    function validOrder(fid) {
      let d = request.resource.data;
      let reward = get(/databases/$(database)/documents/families/$(fid)/rewards/$(d.rewardId)).data;
      return d.uid == request.auth.uid
        && d.status == 'requested'
        && d.decidedBy == null
        && reward.active == true
        && d.price == reward.price;
    }

    // 보상 코인 차감: 같은 묶음에서 승인된 신청과 금액(음수), 사람이 일치해야 한다.
    function validRewardPayout(fid, lid) {
      let order = getAfter(/databases/$(database)/documents/families/$(fid)/orders/$(lid)).data;
      return order.status == 'approved'
        && request.resource.data.amount + order.price == 0
        && order.uid == request.resource.data.uid;
    }

    // 자녀가 새로 적는 할 일: 메모이거나, 첫 코인 제안이어야 한다.
    function validNewProposal() {
      let d = request.resource.data;
      return d.ownerUid == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && (
          (d.status == 'memo' && d.lastAmount == null)
          || (d.status == 'negotiating' && d.lastRole == 'child' && d.offerCount == 1 && validCoins(d.lastAmount))
        );
    }

    // 할 일을 적은 본인이 할 수 있는 변경
    function ownerProposalUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.ownerUid == request.auth.uid
        && after.ownerUid == before.ownerUid
        && (
          // 메모 고치기, 끝냄 표시와 되돌리기
          (before.status in ['memo', 'done'] && after.status in ['memo', 'done'])
          // 협상을 그만두고 메모로 남기기
          || (before.status == 'negotiating' && after.status == 'memo')
          // 부모의 제안에 답하기: 다시 제안하거나 그 금액 그대로 수락
          || (before.status == 'negotiating' && before.lastRole == 'parent' && (
               (after.status == 'negotiating' && after.lastRole == 'child'
                 && after.offerCount == before.offerCount + 1 && validCoins(after.lastAmount))
               || (after.status == 'agreed' && after.lastAmount == before.lastAmount)
             ))
        );
    }

    // 자녀의 제안에 부모가 답하기: 수락, 다른 금액 제안, 거절
    function parentProposalUpdate(fid) {
      let before = resource.data;
      let after = request.resource.data;
      return isParent(fid)
        && before.status == 'negotiating'
        && before.lastRole == 'child'
        && after.ownerUid == before.ownerUid
        && (
          (after.status == 'negotiating' && after.lastRole == 'parent'
            && after.offerCount == before.offerCount + 1 && validCoins(after.lastAmount))
          || (after.status == 'agreed' && after.lastAmount == before.lastAmount)
          || after.status == 'memo'
        );
    }

    // 가족 메모의 모양
    function validNote() {
      let d = request.resource.data;
      return d.text is string && d.text.size() > 0 && d.text.size() <= 100
        && d.toUids is list && d.toUids.size() <= 30
        && d.until is string && d.until.size() <= 10
        && d.readBy is list && d.readBy.size() <= 30;
    }

    // 메모를 받은 사람이 "확인했어요"를 누르는 변경: 확인한 사람 목록에 자기만 더할 수 있다.
    function noteMarkedRead() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.toSet().difference(resource.data.readBy.toSet()) == [request.auth.uid].toSet();
    }

    // 자녀의 보상 제안: 모양 검사
    function validWish() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.note is string && d.note.size() <= 200
        && d.icon is string && d.icon.size() <= 20
        && d.lastPrice is int && d.lastPrice > 0 && d.lastPrice <= 10000
        && d.offerCount is int
        && d.offers is list && d.offers.size() <= 30
        && d.status in ['negotiating', 'agreed', 'declined'];
    }

    // 제안한 본인이 할 수 있는 변경: 부모의 가격에 다시 제안하거나 그 가격 그대로 수락
    function ownerWishUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.ownerUid == request.auth.uid
        && after.ownerUid == before.ownerUid
        && after.title == before.title
        && before.status == 'negotiating'
        && before.lastRole == 'parent'
        && (
          (after.status == 'negotiating' && after.lastRole == 'child' && after.offerCount == before.offerCount + 1)
          || (after.status == 'agreed' && after.lastPrice == before.lastPrice)
        );
    }

    // 자녀의 제안에 부모가 답하기: 다른 가격 제안, 그 가격으로 수락, 거절
    function parentWishUpdate(fid) {
      let before = resource.data;
      let after = request.resource.data;
      return isParent(fid)
        && before.status == 'negotiating'
        && before.lastRole == 'child'
        && after.ownerUid == before.ownerUid
        && after.title == before.title
        && (
          (after.status == 'negotiating' && after.lastRole == 'parent' && after.offerCount == before.offerCount + 1)
          || (after.status == 'agreed' && after.lastPrice == before.lastPrice)
          || (after.status == 'declined' && after.lastPrice == before.lastPrice)
        );
    }

    // 자녀가 부모의 가격을 수락하면서 상점에 올리는 보상(보상 id = 제안 id).
    // 이름과 가격은 합의한 그대로여야 한다.
    function rewardFromWish(fid, rid) {
      let d = request.resource.data;
      let before = get(/databases/$(database)/documents/families/$(fid)/wishes/$(rid)).data;
      let after = getAfter(/databases/$(database)/documents/families/$(fid)/wishes/$(rid)).data;
      return before.ownerUid == request.auth.uid
        && before.status == 'negotiating'
        && before.lastRole == 'parent'
        && after.status == 'agreed'
        && d.title == before.title
        && d.price == before.lastPrice
        && d.active == true;
    }

    function validRewardShape() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.price is int && d.price > 0 && d.price <= 10000
        && d.active is bool;
    }

    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }

    // 위치 공유 코인의 장부 기록 id: 같은 날 같은 순번으로는 한 번만 만들 수 있다.
    function checkinLedgerId(checkin) {
      return 'checkin_' + request.auth.uid + '_' + string(checkin.dayNum) + '_' + string(checkin.count);
    }

    // 위치 공유 코인을 받을 때 내 구성원 정보의 변화:
    // 코인은 설정된 금액만큼만 늘고, 오늘의 횟수가 1 늘며, 하루 한도를 넘지 못한다.
    // 날짜 번호는 서버 시각의 날짜와 하루 넘게 차이 날 수 없고, 지난 날짜로 되돌릴 수 없다.
    // (설정을 한 번도 저장하지 않은 가족의 기본값은 1코인, 하루 3번이다.)
    function validCheckinUpdate(fid) {
      let before = resource.data;
      let after = request.resource.data;
      let settings = get(familyPath(fid)).data.settings;
      let amount = settings.get('checkinCoins', 1);
      let perDay = settings.get('checkinPerDay', 3);
      let today = request.time.toMillis() / 86400000;
      let prev = before.get('checkin', {'dayNum': 0, 'count': 0});
      let lid = checkinLedgerId(after.checkin);
      return after.diff(before).affectedKeys().hasOnly(['coins', 'checkin'])
        && amount is int && amount > 0
        && after.checkin.dayNum is int
        && after.checkin.dayNum >= today - 1
        && after.checkin.dayNum <= today + 1
        && after.checkin.dayNum >= prev.dayNum
        && after.checkin.count == (after.checkin.dayNum == prev.dayNum ? prev.count + 1 : 1)
        && after.checkin.count <= perDay
        && after.coins == before.coins + amount
        && existsAfter(/databases/$(database)/documents/families/$(fid)/ledger/$(lid));
    }

    // 위치 공유 코인의 장부 기록: 같은 묶음에서 바뀐 내 구성원 정보와 금액, 순번이 맞아야 한다.
    function validCheckinPayout(fid, lid) {
      let d = request.resource.data;
      let me = getAfter(memberPath(fid, request.auth.uid)).data;
      let settings = get(familyPath(fid)).data.settings;
      return d.type == 'checkin'
        && d.uid == request.auth.uid
        && d.by == request.auth.uid
        && d.amount == settings.get('checkinCoins', 1)
        && lid == checkinLedgerId(me.checkin);
    }

    function validPoint(d) {
      return d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180;
    }

    // 캘린더 일정의 모양
    function validEvent() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.memo is string && d.memo.size() <= 100
        && d.startDay is string && d.startDay.size() == 10
        && d.endDay is string && d.endDay.size() == 10 && d.endDay >= d.startDay
        && d.allDay is bool
        && d.who is list && d.who.size() <= 30
        && d.repeat in ['none', 'weekly', 'monthly', 'yearly'];
    }

    // 뭐먹지 메뉴의 모양
    function validFood() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.link is string && d.link.size() <= 300
        && d.memo is string && d.memo.size() <= 60
        && d.category is string && d.category.size() > 0 && d.category.size() <= 20
        && d.wantedBy is list && d.wantedBy.size() <= 30
        && d.eaten is list && d.eaten.size() <= 200
        && d.get('ratings', {}) is map
        && d.active is bool;
    }

    // 별점은 자기 것만, 1개부터 5개까지 줄 수 있다.
    function validMyRating() {
      let after = request.resource.data.get('ratings', {});
      let before = resource.data.get('ratings', {});
      return after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || after[request.auth.uid] in [1, 2, 3, 4, 5]);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      // 코드를 아는 사람만 한 건씩 읽을 수 있다(목록 조회 불가).
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role in ['parent', 'child']
        && isParent(request.resource.data.familyId);
      allow delete: if signedIn() && isParent(resource.data.familyId);
    }

    match /families/{fid} {
      allow get: if isMember(fid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // 가족 이름과 설정은 부모만 바꾼다.
      allow update: if isParent(fid) && request.resource.data.createdBy == resource.data.createdBy;

      match /members/{uid} {
        allow read: if isMember(fid);

        // 가족을 만든 사람은 부모로, 그 밖에는 초대코드에 적힌 역할로만 들어올 수 있다.
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.coins == 0
          && request.resource.data.role in ['parent', 'child']
          && (
            (request.resource.data.role == 'parent'
              && getAfter(/databases/$(database)/documents/families/$(fid)).data.createdBy == uid)
            || (request.resource.data.inviteCode is string
              && validInvite(fid, request.resource.data.inviteCode, request.resource.data.role))
          );

        // 본인은 이름, 캐릭터, 목표 보상만. 부모는 코인과 연속 달성 기록만 바꿀 수 있다.
        // 코인은 0 아래로 내려갈 수 없다. 본인이 코인을 늘릴 수 있는 경우는 위치 공유 코인뿐이다.
        allow update: if isMember(fid) && (
          (uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatar', 'goalRewardId']))
          || (uid == request.auth.uid && validCheckinUpdate(fid))
          || (isParent(fid)
            && request.resource.data.coins >= 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'streak']))
        );
      }

      match /quests/{qid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validQuest(fid)
          && (isParent(fid) || questFromAgreement(fid, qid) || questFromPreset(fid, qid));
        allow update: if isParent(fid) && validQuest(fid);
      }

      match /presets/{pid} {
        allow read: if isMember(fid);
        allow create, update: if isParent(fid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 40
          && request.resource.data.reward is int
          && request.resource.data.reward >= 0 && request.resource.data.reward <= 1000;
        allow delete: if isParent(fid);
      }

      match /rewards/{rid} {
        allow read: if isMember(fid);
        // 보상은 부모가 올린다. 자녀는 부모와 가격을 합의한 제안만 올릴 수 있다.
        allow create: if isMember(fid) && validRewardShape() && (isParent(fid) || rewardFromWish(fid, rid));
        allow update: if isParent(fid) && validRewardShape();
      }

      match /notes/{nid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validNote()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.readBy.size() == 0;
        // 고치기는 쓴 사람과 부모만. 받은 사람은 확인 표시만 할 수 있다.
        allow update: if isMember(fid) && validNote()
          && request.resource.data.createdBy == resource.data.createdBy
          && (resource.data.createdBy == request.auth.uid || isParent(fid) || noteMarkedRead());
        allow delete: if isMember(fid)
          && (resource.data.createdBy == request.auth.uid || isParent(fid));
      }

      match /wishes/{wid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validWish()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'negotiating'
          && request.resource.data.lastRole == 'child'
          && request.resource.data.offerCount == 1;
        allow update: if isMember(fid) && validWish() && (ownerWishUpdate() || parentWishUpdate(fid));
        // 상점에 올라가기 전이라면 제안한 본인이 그만두거나 지울 수 있다.
        allow delete: if isMember(fid)
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status != 'agreed';
      }

      match /orders/{oid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validOrder(fid);
        allow update: if isParent(fid) && (
          // 신청을 승인하거나 거절
          (resource.data.status == 'requested'
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.decidedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'decidedBy', 'decidedAt', 'rejectReason']))
          // 승인한 보상을 실제로 준 뒤 마무리
          || (resource.data.status == 'approved'
            && request.resource.data.status == 'delivered'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'deliveredBy', 'deliveredAt']))
        );
        // 승인 전에는 신청한 본인이 취소할 수 있다.
        allow delete: if isMember(fid)
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'requested';
      }

      match /foods/{foodId} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validFood()
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.get('ratings', {}).size() == 0;
        // 먹고 싶다는 표시, 먹은 날 기록, 내 별점은 누구나. 그 밖의 변경은 올린 사람과 부모만.
        allow update: if isMember(fid) && validFood() && validMyRating()
          && request.resource.data.addedBy == resource.data.addedBy
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wantedBy', 'eaten', 'ratings'])
            || resource.data.addedBy == request.auth.uid
            || isParent(fid)
          );
      }

      match /events/{eventId} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validEvent()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(fid) && validEvent()
          && request.resource.data.createdBy == resource.data.createdBy
          && (resource.data.createdBy == request.auth.uid || isParent(fid));
        allow delete: if isMember(fid)
          && (resource.data.createdBy == request.auth.uid || isParent(fid));
      }

      match /locations/{locId} {
        allow read: if isMember(fid);
        // 자기 위치만 남길 수 있다.
        allow create: if isMember(fid)
          && request.resource.data.uid == request.auth.uid
          && validPoint(request.resource.data)
          && request.resource.data.at is int
          && request.resource.data.trigger in ['button', 'open', 'quest'];
        // 오래된 기록 정리는 부모가, 자기 기록은 본인도 지울 수 있다.
        allow delete: if isMember(fid) && (resource.data.uid == request.auth.uid || isParent(fid));
      }

      match /places/{placeId} {
        allow read: if isMember(fid);
        allow create, update: if isParent(fid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && validPoint(request.resource.data)
          && request.resource.data.radius is int
          && request.resource.data.radius >= 50 && request.resource.data.radius <= 1000;
        allow delete: if isParent(fid);
      }

      match /proposals/{pid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validNewProposal();
        allow update: if isMember(fid) && (ownerProposalUpdate() || parentProposalUpdate(fid));
        // 퀘스트가 되기 전이라면 적은 본인이 지울 수 있다.
        allow delete: if isMember(fid)
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status != 'agreed';
      }

      match /runs/{rid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validSubmission(fid, rid);
        allow update: if isMember(fid) && (
          // 돌려받은 퀘스트를 자녀가 다시 제출
          (resource.data.status == 'rejected' && validSubmission(fid, rid))
          // 부모의 승인 또는 반려
          || (isParent(fid)
            && resource.data.status == 'submitted'
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.decidedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'decidedBy', 'decidedAt', 'rejectReason', 'praise']))
        );
        // 확인 전에는 자녀가 완료 요청을 취소할 수 있다.
        allow delete: if isMember(fid)
          && resource.data.assigneeUid == request.auth.uid
          && resource.data.status == 'submitted';
      }

      match /ledger/{lid} {
        allow read: if isMember(fid);
        // 장부는 추가만 가능하다(수정, 삭제 불가). 같은 수행 기록으로 두 번 지급할 수 없다.
        // 부모가 아닌 사람이 남길 수 있는 기록은 위치 공유 코인뿐이다.
        allow create: if request.resource.data.amount is int && (
          (isParent(fid)
            && request.resource.data.by == request.auth.uid
            && request.resource.data.type != 'checkin'
            && (request.resource.data.type != 'quest' || validQuestPayout(fid, lid))
            && (request.resource.data.type != 'reward' || validRewardPayout(fid, lid)))
          || (isMember(fid) && validCheckinPayout(fid, lid))
        );
      }
    }
  }
}
